{
  "name": "openqueries",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@8.10.5",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @openqueries/web build && pnpm --filter @openqueries/extension build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @openqueries/web deploy:dry-run",
    "dev:extension": "pnpm --filter @openqueries/extension dev",
    "dev:web": "pnpm --filter @openqueries/web dev",
    "lint": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "pnpm": {
    "overrides": {
      "content-security-policy-parser": "0.6.0",
      "msgpackr": "1.12.1",
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  }
}
