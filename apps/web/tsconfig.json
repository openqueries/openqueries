{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@openqueries/contracts": ["../../packages/contracts/src/index.ts"],
      "@openqueries/provider-icons": [
        "../../packages/provider-icons/src/index.tsx"
      ],
      "@openqueries/query-core": ["../../packages/query-core/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
