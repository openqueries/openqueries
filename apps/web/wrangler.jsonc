{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openqueries",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openqueries-db",
      "database_id": "b70b2bf1-d737-4e6b-aab0-dde704d0232c",
      "migrations_dir": "drizzle",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "DONATION_QUEUE", "queue": "openqueries-donations" },
    ],
    "consumers": [
      {
        "queue": "openqueries-donations",
        "dead_letter_queue": "openqueries-donations-dlq",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 10,
      },
    ],
  },
  "ratelimits": [
    {
      "name": "FANOUT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "triggers": {
    "crons": ["17 2 * * *"],
  },
  "vars": {
    "SITE_ORIGIN": "https://openqueries.org",
    "ALLOWED_EXTENSION_IDS": "",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "ANTHROPIC_MODEL": "claude-haiku-4-5-20251001",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "OPENAI_SCORER_MODEL": "gpt-5.6-luna",
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
  },
}
