{
  "name": "@openqueries/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "deploy": "pnpm build && wrangler d1 migrations apply openqueries-db --remote && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "typecheck": "pnpm cf-typegen && tsc --noEmit"
  },
  "dependencies": {
    "@openqueries/contracts": "workspace:*",
    "@openqueries/provider-icons": "workspace:*",
    "@openqueries/query-core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "katex": "0.16.22",
    "lucide-react": "1.30.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "simple-icons": "16.28.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/katex": "0.16.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.120.0"
  }
}
