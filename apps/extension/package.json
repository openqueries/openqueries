{
  "name": "@openqueries/extension",
  "displayName": "Open Queries – AI Search Query Inspector",
  "version": "1.0.3",
  "description": "See ChatGPT, Claude and Google AI search queries in a local side panel, then inspect likely fan-out queries on demand.",
  "author": "Open Queries contributors",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "plasmo build && tsx tests/build-smoke.ts",
    "dev": "plasmo dev",
    "package": "plasmo package",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openqueries/contracts": "workspace:*",
    "@openqueries/provider-icons": "workspace:*",
    "@openqueries/query-core": "workspace:*",
    "lucide-react": "1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/chrome": "0.2.5",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "plasmo": "0.90.5",
    "tsx": "4.23.11",
    "typescript": "5.9.3"
  },
  "manifest": {
    "minimum_chrome_version": "114",
    "permissions": [
      "sidePanel",
      "storage"
    ],
    "host_permissions": [
      "https://chatgpt.com/*",
      "https://openqueries.org/*"
    ],
    "action": {
      "default_title": "Open Queries"
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  }
}
